//
// Qualcomm decryption files
//

prebuilt_root {
    name: "qcom_decrypt_init_rc",
    src: "crypto/init.recovery.qcom_decrypt.rc",
    filename: "init.recovery.qcom_decrypt.rc",
    install_in_root: true,
}

prebuilt_root {
    name: "qcom_decrypt_fbe_init_rc",
    src: "crypto_fbe/init.recovery.qcom_decrypt.fbe.rc",
    filename: "init.recovery.qcom_decrypt.fbe.rc",
    install_in_root: true,
}

prebuilt_etc {
    name: "qcom_decrypt_prepdecrypt",
    src: "crypto/system/bin/prepdecrypt.sh",
    filename: "prepdecrypt.sh",
    sub_dir: "system/bin",
    recovery: true,
}

cc_prebuilt_binary {
    name: "7za",
    srcs: ["7za"],
    recovery: true,
    relative_install_path: "system/bin",
}

prebuilt_etc {
    name: "mkshrc_twrp",
    src: "mkshrc_twrp",
    filename: "mkshrc",
    sub_dir: "system/etc",
    recovery: true,
}

//
// Required modules
//

phony {
    name: "qcom_decrypt",
    required: [
        "resetprop",
        "7za",
        "qcom_decrypt_init_rc",
        "qcom_decrypt_prepdecrypt",
        "mkshrc_twrp",
    ],
}

phony {
    name: "qcom_decrypt_fbe",
    required: [
        "qcom_decrypt",
        "qcom_decrypt_fbe_init_rc",
    ],
}
